# ============================================================
# LeadFinder Pro — variáveis de ambiente
# Copie para .env.local (dev) e cadastre também na Vercel.
# NUNCA faça commit de valores reais.
# ============================================================

# --- Supabase (obrigatório) ---------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# SOMENTE SERVIDOR. Usada para formulários públicos, DSAR e convites. Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- URL pública do app -------------------------------------
# Usada em links de recuperação de senha e no código de incorporação de formulários.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Fontes de dados (opcionais) ----------------------------
# Google Places API (New). Ative "Places API (New)" no Google Cloud e restrinja a chave por API.
GOOGLE_PLACES_API_KEY=

# --- WhatsApp Business Platform (opcional, envio automatizado) ---
# O app funciona sem isto usando links oficiais wa.me (conversa iniciada pelo usuário).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Segurança ----------------------------------------------
# Sal para hash de IPs em submissões de formulário (qualquer string longa e aleatória).
IP_HASH_SALT=troque-por-uma-string-aleatoria-longa
